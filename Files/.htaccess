RewriteEngine On

# Redirect HTTP to HTTPS automatically
RewriteCond %{HTTPS} off
RewriteCond %{HTTP_HOST} ^(www\.)?sudarshanfitness\.de$ [NC]
RewriteRule ^(.*)$ https://sudarshanfitness.de/$1 [L,R=301]

<IfModule mod_headers.c>
    # Enterprise Security Headers
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
    Header set X-Content-Type-Options "nosniff"
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
    Header set Permissions-Policy "geolocation=(self), microphone=(), camera=(self)"

    # Digital Asset Links, Web Manifest & Images CORS
    <FilesMatch "\.(json|png|jpg|jpeg|svg|ico)$">
        Header set Access-Control-Allow-Origin "*"
    </FilesMatch>

    # Android APK Download MIME Type & Force Download Header
    AddType application/vnd.android.package-archive .apk
    <FilesMatch "\.(apk)$">
        Header set Content-Type "application/vnd.android.package-archive"
        Header set Content-Disposition "attachment; filename=\"sudarshan_fitness.apk\""
    </FilesMatch>
</IfModule>
